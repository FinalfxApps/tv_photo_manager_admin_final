    'nameEn': nameEn, 'nameAr': nameAr, 'oldPrice': oldPrice, 'offerPrice': offerPrice,
    'imageUrl': imageUrl, 'startDate': Timestamp.fromDate(startDate), 'endDate': Timestamp.fromDate(endDate),
    'active': active, 'updatedAt': FieldValue.serverTimestamp(),
  };
