  String nameEn, nameAr, imageUrl;
  double oldPrice, offerPrice;
  DateTime startDate, endDate;
  bool active;

  factory FxMasterOffer.fromDoc(DocumentSnapshot<Map<String, dynamic>> d) {
    final x = d.data() ?? {};
    DateTime read(String k) => x[k] is Timestamp ? (x[k] as Timestamp).toDate() : DateTime.now();
