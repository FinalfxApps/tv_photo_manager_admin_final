Future<String?> fxMasterTranslateArabic(String input) async {
  final q = input.trim();
  if (q.isEmpty) return null;

  const dictionary = <String, String>{
    'broast': 'بروست', 'broasted': 'بروستد', 'burger': 'برجر',
    'burgers': 'برجر', 'chicken': 'دجاج', 'fries': 'بطاطس مقلية',
    'pizza': 'بيتزا', 'shawarma': 'شاورما', 'sandwich': 'ساندويتش',
    'sandwiches': 'ساندويتشات', 'nuggets': 'ناجتس', 'wings': 'أجنحة دجاج',
    'rice': 'أرز', 'salad': 'سلطة', 'dessert': 'حلويات',
    'desserts': 'حلويات', 'drinks': 'مشروبات', 'beverages': 'مشروبات',
    'meals': 'وجبات', 'appetizers': 'مقبلات', 'breakfast': 'فطور',
    'seafood': 'مأكولات بحرية', 'sauce': 'صلصة', 'sauces': 'صلصات',
    'kids': 'أطفال', 'family meal': 'وجبة عائلية',
    'family meals': 'وجبات عائلية', 'hot drinks': 'مشروبات ساخنة',
    'cold drinks': 'مشروبات باردة',
  };
  final exact = dictionary[q.toLowerCase()];
  if (exact != null) return exact;

  try {
    final uri = Uri.https('translate.googleapis.com', '/translate_a/single', {
      'client': 'gtx', 'sl': 'en', 'tl': 'ar', 'dt': 't', 'q': q,
    });
    final r = await http.get(uri).timeout(const Duration(seconds: 8));
    if (r.statusCode != 200) return null;
    final data = jsonDecode(r.body);
    if (data is List && data.isNotEmpty && data[0] is List) {
      final parts = <String>[];
      for (final row in data[0]) {
        if (row is List && row.isNotEmpty && row[0] != null) {
          final v = row[0].toString().trim();
          if (v.isNotEmpty) parts.add(v);
        }
      }
      final result = parts.join();
      return result.isEmpty ? null : result;
    }
  } catch (_) {}
  return null;
}

Future<String?> fxMasterUpload(PlatformFile file, String folder) async {
  try {
    final bytes = await file.readAsBytes();
    final safe = file.name.replaceAll(RegExp(r'[/\\]'), '_');
    final ref = FirebaseStorage.instance.ref().child(folder).child(
      '${DateTime.now().microsecondsSinceEpoch}_$safe',
    );
    await ref.putData(bytes, SettableMetadata(contentType: _mime(file.extension)));
    return ref.getDownloadURL();
  } catch (_) {
    return null;
  }
}

String _mime(String? ext) {
  switch ((ext ?? '').toLowerCase()) {
    case 'jpg': case 'jpeg': return 'image/jpeg';
    case 'png': return 'image/png';
    case 'webp': return 'image/webp';
    case 'mp4': return 'video/mp4';
    case 'webm': return 'video/webm';
    case 'mov': case 'm4v': return 'video/mp4';
    default: return 'application/octet-stream';
  }
}

